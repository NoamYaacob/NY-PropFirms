// Usage: node --experimental-strip-types scripts/gen-slot-report.mts <out.md>
// Generated report: route -> token -> declared context -> rendered lines -> records rendered.
import { writeFileSync } from "node:fs";
import { ctxFor } from "../src/components/copy/slotContext.ts";
import { lineText, resolveSlot } from "../src/components/copy/slotModel.ts";
import { listTokenSites } from "../src/components/copy/slotEnumerate.ts";

const routeOf = (p: string) => (p === "home" ? "/" : `/${p}`);
const rows: string[] = [
  "# Slot render report (route, token, context, lines, records)",
  "",
  "Generated by `scripts/gen-slot-report.mts` from `content/pages/*.md`, `src/components/copy/slotContext.ts` and `slotModel.ts`.",
  "Context: type / stage / size. `each` = every type or stage, each line labelled; `na` = type- or stage-neutral records only; `dup` = already rendered on the same line.",
  "Sections that a tool component replaces (calculator panels) do not print their copy tokens; they are listed here because the copy declares them.",
  "",
  "| Route | Token | Context | Rendered lines | Records |",
  "|---|---|---|---|---|",
];
for (const s of listTokenSites()) {
  const ctx = ctxFor(s.page, s.token, s.line)!;
  const lines = resolveSlot(s.token, ctx);
  const text = lines.length ? lines.map((l) => lineText(l).replace(/\|/g, "/")).join("<br>") : ctx.dup ? "(duplicate of the same key on this line, not printed)" : "(nothing)";
  const ids = [...new Set(lines.flatMap((l) => l.recordIds))];
  rows.push(`| ${routeOf(s.page)} | \`${s.token.slice(1, -1)}\` | ${ctx.type} / ${ctx.stage} / ${ctx.size} | ${text} | ${ids.length ? ids.join(", ") : "-"} |`);
}
writeFileSync(process.argv[2], rows.join("\n") + "\n");
console.log(`${rows.length - 7} sites`);
