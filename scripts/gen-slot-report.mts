// Usage: node --experimental-strip-types scripts/gen-slot-report.mts <out.md>
// Generated report: route -> token -> declared context -> rendered lines -> records rendered.
import { writeFileSync } from "node:fs";
import { SITE_DATA_RECORDS } from "../src/data/apexRecords.ts";
import { ctxFor, distinctKeysOnLine } from "../src/components/copy/slotContext.ts";
import { lineText, resolveSlot } from "../src/components/copy/slotModel.ts";
import { listTokenSites } from "../src/components/copy/slotEnumerate.ts";

const byId = new Map(SITE_DATA_RECORDS.map((r) => [r.id, r]));
const routeOf = (p: string) => (p === "home" ? "/" : `/${p}`);
let empty = 0;
let unlabelled = 0;
let lineCount = 0;
const body: string[] = [];
for (const s of listTokenSites()) {
  const ctx = ctxFor(s.page, s.token, s.line)!;
  const lines = resolveSlot(s.token, ctx, distinctKeysOnLine(s.page, s.line).length);
  for (const l of lines) {
    lineCount++;
    if (!l.body && !l.link && !l.links?.length) empty++;
    if (l.recordIds.length && l.body && !l.label && !ctx.named) {
      const r = byId.get(l.recordIds[0])!;
      if (["EOD", "Intraday", "Legacy"].includes(r.applies_to.account_type) || ["Eval", "PA"].includes(r.applies_to.stage)) unlabelled++;
    }
  }
  const text = lines.length
    ? lines.map((l) => lineText(l).replace(/\|/g, "/")).join("<br>")
    : ctx.dup ? "(same key already printed on this page; not repeated)" : ctx.none ? "(index-only record, never printed)" : "(nothing)";
  const ids = [...new Set(lines.flatMap((l) => l.recordIds))];
  const flag = ctx.named ? " (copy names it)" : "";
  body.push(`| ${routeOf(s.page)} | \`${s.token.slice(1, -1)}\` | ${ctx.type} / ${ctx.stage} / ${ctx.size}${flag} | ${text} | ${ids.length ? ids.join(", ") : "-"} |`);
}
const head = [
  "# Slot render report (route, token, context, lines, records)",
  "",
  "Generated by `scripts/gen-slot-report.mts` from `content/pages/*.md`, `src/components/copy/slotContext.ts` and `slotModel.ts`. The text column is the exact text the page prints for that token (label, value, derived note, source chip with its date).",
  "Context: type / stage / size. `each` = every type or stage, each line labelled; `na` = type- or stage-neutral records only; `named` = the copy puts a bold type/stage label right before the token.",
  "Sections that a tool component replaces (calculator panels) do not print their copy tokens; they are listed here because the copy declares them.",
  "",
  `**Counts: ${body.length} token sites, ${lineCount} rendered lines, empty lines (label + source chip, no value) = ${empty}, unlabelled typed/staged value lines = ${unlabelled}.**`,
  "",
  "| Route | Token | Context | Rendered lines | Records |",
  "|---|---|---|---|---|",
];
writeFileSync(process.argv[2], [...head, ...body].join("\n") + "\n");
console.log(`sites=${body.length} lines=${lineCount} empty=${empty} unlabelled=${unlabelled}`);
